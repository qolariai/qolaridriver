    }
}

server {
    listen 443 ssl http2;
    server_name admin-driver.qolari.com;

    ssl_certificate     /etc/letsencrypt/live/admin-driver.qolari.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin-driver.qolari.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 10m;
    proxy_http_version 1.1;
