<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ql_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ql_margin"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/ql_margin"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a11y_close"
            android:padding="13dp"
            android:src="@drawable/ic_close"
            app:tint="@color/ql_black" />

        <!-- Cabeçalho real (042_menu_2/atual): nome em maiúsculas à esquerda, avatar à direita. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/ql_black"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/avatar"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:textColor="@color/ql_black"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rating"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/helpTile"
                android:layout_width="0dp"
                android:layout_height="98dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lifebuoy"
                    app:tint="@color/ql_black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/menu_help"
                    android:textColor="@color/ql_black"
                    android:textSize="19sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/walletTile"
                android:layout_width="0dp"
                android:layout_height="98dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_wallet"
                    app:tint="@color/ql_black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/menu_wallet"
                    android:textColor="@color/ql_black"
                    android:textSize="19sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/activityTile"
                android:layout_width="0dp"
                android:layout_height="98dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tile"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_activity"
                    app:tint="@color/ql_black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/menu_activity"
                    android:textColor="@color/ql_black"
                    android:textSize="19sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cashRow"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tile"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/menu_cash"
                android:textColor="@color/ql_black"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/cashValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="0,00 €"
                android:textColor="@color/ql_black"
                android:textSize="30sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/accountRow"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_account"
                app:tint="@color/ql_black" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="@string/menu_manage_account"
                android:textColor="@color/ql_black"
                android:textSize="22sp" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron"
                android:visibility="gone"
                app:tint="@color/ql_gray_400" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="44dp"
            android:background="@color/ql_divider" />

        <LinearLayout
            android:id="@+id/promotionsRow"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tag"
                app:tint="@color/ql_black" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="@string/menu_promotions"
                android:textColor="@color/ql_black"
                android:textSize="22sp" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron"
                android:visibility="gone"
                app:tint="@color/ql_gray_400" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="44dp"
            android:background="@color/ql_divider" />

        <LinearLayout
            android:id="@+id/legalRow"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_info_circle"
                app:tint="@color/ql_black" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:text="@string/menu_legal"
                android:textColor="@color/ql_black"
                android:textSize="22sp" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron"
                android:visibility="gone"
                app:tint="@color/ql_gray_400" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/signOutButton"
            style="@style/Widget.QolariLite.Button.Light"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="40dp"
            android:text="@string/menu_sign_out"
            android:textColor="@color/ql_red"
            app:cornerRadius="8dp" />

    </LinearLayout>
</ScrollView>
