# Exemplo de nginx para o laboratório/produção. Copiar para /etc/nginx/sites-available e
# ajustar domínios, certificados e caminhos. Não é aplicado automaticamente.

upstream qolari_driver  { server 127.0.0.1:8091; keepalive 16; }
upstream qolari_rider   { server 127.0.0.1:8090; keepalive 16; }
upstream qolari_fleet   { server 127.0.0.1:3000; keepalive 16; }
upstream qolari_console { server 127.0.0.1:8300; keepalive 16; }

server {
    listen 80;
    server_name driver.qolari.com rider.qolari.com fleet.qolari.com admin-driver.qolari.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name driver.qolari.com;

    ssl_certificate     /etc/letsencrypt/live/driver.qolari.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/driver.qolari.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 10m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location / {
        proxy_pass http://qolari_driver;
    }
}

server {
    listen 443 ssl http2;
    server_name rider.qolari.com;

    ssl_certificate     /etc/letsencrypt/live/rider.qolari.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rider.qolari.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 10m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location / {
        proxy_pass http://qolari_rider;
    }
}

