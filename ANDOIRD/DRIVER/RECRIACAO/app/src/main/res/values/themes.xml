<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cores semânticas: apontam para a paleta medida na original (colors_core.xml, gerada de design_tokens.json). -->
    <color name="qd_primary">@color/qd_core_black</color>
    <color name="qd_on_primary">@color/qd_core_white</color>
    <color name="qd_accent">@color/qd_core_blue600</color>
    <color name="qd_background">@color/qd_core_white</color>
    <color name="qd_nav_active">#111111</color>
    <color name="qd_ink">#111111</color>
    <color name="qd_tile">#f6f6f6</color>
    <color name="qd_line">@color/qd_core_gray200</color>
    <color name="qd_chevron">@color/qd_core_gray300</color>
    <color name="qd_gold">@color/qd_core_yellow300</color>
    <color name="qd_surface_variant">@color/qd_core_gray50</color>
    <color name="qd_divider">@color/qd_core_gray100</color>
    <color name="qd_text_primary">@color/qd_core_black</color>
    <color name="qd_text_secondary">@color/qd_core_gray900</color>
    <color name="qd_error">@color/qd_core_red600</color>
    <color name="qd_success">@color/qd_core_green600</color>

    <!-- Cartão da proposta, medido no vídeo de 2026-10-29 (frames em ux_capture/videos/2026-10-29_pedido). -->
    <color name="qd_offer_secondary">#525252</color>
    <color name="qd_offer_pill">#ececec</color>
    <color name="qd_offer_divider">#d9d9d9</color>
    <color name="qd_offer_close_bg">#f6f6f6</color>
    <!-- Etiqueta "Exclusivo"/"Radar" no cartão da proposta (azul da marca). -->
    <color name="qd_offer_kind">#276ef1</color>
    <!-- Botao "Aceitar" do cartao do pedido: azul medido no video (#246CF0). -->
    <color name="qd_offer_accept">#246CF0</color>
    <!-- Radar: cartão apagado enquanto "A verificar se é a melhor correspondência". -->
    <color name="qd_offer_dim">#99ffffff</color>
    <!-- Painel de navegação (vídeo 2026-10-29): preto opaco. -->
    <color name="qd_maneuver_bg">#FF000000</color>
    <!-- Texto secundário do painel ("em direção a"), cinza claro como no vídeo de 2026-10-30. -->
    <color name="qd_maneuver_secondary">#BDBDBD</color>
    <!-- Vermelho do botão "Parar novos pedidos" (print 2026-10-30, 01:57). -->
    <color name="qd_stop_red">#C9110B</color>
    <!-- Paragens no painel de navegação (vídeo 2026-10-30): verde na recolha, vermelho no destino. -->
    <color name="qd_stop_pickup">#077E41</color>
    <color name="qd_stop_dropoff">#CB2509</color>
    <!-- Botão OFFLINE/ONLINE do "Recomendado para si" (print 2026-10-30). -->
    <color name="qd_offline_bg">#D9D9D9</color>
    <color name="qd_offline_ring">#F2F2F2</color>
    <color name="qd_offline_gray">#8C8C8C</color>
    <!-- Traço: aproximação a preto, percurso a vermelho (vídeo 2026-10-30). -->
    <color name="qd_route_leg">#111111</color>
    <color name="qd_route_trip">#e01e37</color>

    <!-- A original tem "Modo noturno: Sempre desligado" por omissão (captura 043): tema só claro. -->
    <style name="Theme.QolariDriver" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/qd_primary</item>
        <item name="colorOnPrimary">@color/qd_on_primary</item>
        <item name="colorSecondary">@color/qd_accent</item>
        <item name="android:colorBackground">@color/qd_background</item>
        <item name="colorSurface">@color/qd_background</item>
        <item name="colorSurfaceContainer">@color/qd_background</item>
        <item name="colorOnSurface">@color/qd_text_primary</item>
        <!-- Sem sobreposicao de elevacao: o Material tingia o branco com colorPrimary (preto) e dava #EAEAEA na barra e no cartao. -->
        <item name="elevationOverlayEnabled">false</item>
        <item name="colorError">@color/qd_error</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- A original tem a barra de gestos branca com a pílula cinzenta (captura 064). -->
        <item name="android:navigationBarColor">@color/qd_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="bottomNavigationStyle">@style/Widget.QolariDriver.BottomNav</item>
    </style>

    <!-- Barra de 5 separadores: rótulo a negrito no separador ativo, sem fundo de seleção (ux_behavior.md §1.1). -->
    <style name="Widget.QolariDriver.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/qd_background</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.QolariDriver.BottomNav.NoIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconSize">24dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:minHeight">68dp</item>
        <item name="itemPaddingTop">10dp</item>
        <item name="itemPaddingBottom">12dp</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.QolariDriver.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.QolariDriver.NavLabel</item>
    </style>
    <style name="Widget.QolariDriver.BottomNav.NoIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <!-- Rotulos da barra: mais pequenos que o padrao do Material 3 (a original trunca menos), ativo a negrito. -->
    <style name="TextAppearance.QolariDriver.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <!-- Tem de herdar do rótulo normal: sem parent ficava nos 14sp e as etiquetas sobrepunham-se (captura 064). -->
    <style name="TextAppearance.QolariDriver.NavLabel.Active" parent="TextAppearance.QolariDriver.NavLabel">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botões de filtro de Descobrir (captura 036): cinzentos desligados, pretos ligados (selecionado). -->
    <style name="Widget.QolariDriver.Chip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_chip_state</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableTint">@color/chip_text</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Célula da grelha de relatórios de mapa (print 2026-10-30, 02:16). -->
    <style name="QdReportCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Etiqueta por baixo do sinal do relatório. -->
    <style name="QdReportLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textColor">@color/qd_ink</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
