<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- Janela da captura 051: título centrado, texto em inglês (como na original), dois botões. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:text="@string/push_sheet_title"
        android:textColor="@color/qd_ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/qd_line" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/push_sheet_body"
        android:textColor="@color/qd_ink"
        android:textSize="18sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pushUpdate"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="@string/push_sheet_update"
        android:textColor="@color/qd_core_white"
        android:textSize="18sp"
        app:backgroundTint="@color/qd_ink"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pushCancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/push_sheet_cancel"
        android:textColor="@color/qd_ink"
        android:textSize="18sp"
        app:backgroundTint="@color/qd_tile"
        app:cornerRadius="8dp" />
</LinearLayout>
