<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_margin="12dp"
    android:background="@drawable/bg_card_drive"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <View
        android:id="@+id/offerTimer"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_timer_bar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/offerProduct"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_product"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:textColor="@color/qd_core_white"
            android:textSize="16sp"
            app:drawableStartCompat="@drawable/ic_person"
            app:drawableTint="@color/qd_core_white" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/offerClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_close_square"
            android:contentDescription="@string/drive_decline"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            app:tint="@color/qd_ink" />
    </LinearLayout>

    <TextView
        android:id="@+id/offerPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/qd_ink"
        android:textSize="40sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_pill_gray_soft"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/drive_after_fee"
        android:textColor="@color/qd_ink"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/qd_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/offerPickupLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/qd_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/offerPickupAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/qd_core_gray600"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/offerTripLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/qd_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offerDropoffAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/qd_core_gray600"
            android:textSize="16sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/offerAccept"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/drive_accept"
        android:textColor="@color/qd_core_white"
        android:textSize="18sp"
        app:backgroundTint="@color/qd_core_blue600"
        app:cornerRadius="8dp" />
</LinearLayout>
