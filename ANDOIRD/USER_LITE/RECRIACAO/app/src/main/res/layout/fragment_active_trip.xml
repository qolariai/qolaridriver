<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ql_white">

    <com.qolari.userlite.ui.map.RealMapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/closeButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_map_control"
        android:contentDescription="@string/a11y_close"
        android:padding="12dp"
        android:src="@drawable/ic_close"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ql_black" />

    <ImageButton
        android:id="@+id/menuButton"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_map_control"
        android:contentDescription="@string/a11y_menu"
        android:padding="12dp"
        android:src="@drawable/ic_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/ql_black" />

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_sheet"
        android:elevation="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/map">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ql_margin"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/ql_margin"
                android:paddingBottom="24dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_search" />

                <TextView
                    android:id="@+id/statusTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/ql_black"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/statusEta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/ql_black"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/statusDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/ql_gray_500"
                    android:textSize="15sp" />

                <ProgressBar
                    android:id="@+id/searchProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="14dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="8"
                    android:progressBackgroundTint="@color/ql_gray_200"
                    android:progressTint="@color/ql_blue"
                    android:visibility="gone" />

                <!-- Cartão "Detalhes da viagem" (recolhível, como no original). -->
                <LinearLayout
                    android:id="@+id/routeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/detailsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/trip_details_title"
                                android:textColor="@color/ql_gray_500"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/detailsCollapsed"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/ql_black"
                                android:textSize="18sp" />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/detailsToggle"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_tile"
                            android:contentDescription="@string/trip_details_expand"
                            android:padding="12dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="@color/ql_black" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/detailsBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_pin_dot"
                                app:tint="@color/ql_black" />

                            <TextView
                                android:id="@+id/pickupText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:textColor="@color/ql_black"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_pin_square"
                                app:tint="@color/ql_black" />

                            <TextView
                                android:id="@+id/dropoffText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:textColor="@color/ql_black"
                                android:textSize="16sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/changeDropoff"
                                style="@style/Widget.QolariLite.Button.Ghost"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:background="@drawable/bg_chip_soft"
                                android:minWidth="0dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="@string/trip_change"
                                android:textSize="14sp"
                                app:backgroundTint="@color/ql_gray_50"
                                app:cornerRadius="18dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_wallet"
                                app:tint="@color/ql_black" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/detailsFare"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/ql_black"
                                    android:textSize="16sp" />

                                <TextView
                                    android:id="@+id/detailsPayment"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/ql_gray_500"
                                    android:textSize="14sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_shield"
                                app:tint="@color/ql_black" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/trip_security"
                                android:textColor="@color/ql_black"
                                android:textSize="16sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/securityButton"
                                style="@style/Widget.QolariLite.Button.Ghost"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="0dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="@string/trip_security_action"
                                android:textSize="14sp"
                                app:backgroundTint="@color/ql_gray_50"
                                app:cornerRadius="18dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_crosshair"
                                app:tint="@color/ql_black" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/trip_share_title"
                                android:textColor="@color/ql_black"
                                android:textSize="16sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/shareButton"
                                style="@style/Widget.QolariLite.Button.Ghost"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="0dp"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp"
                                android:text="@string/trip_share_action"
                                android:textSize="14sp"
                                app:backgroundTint="@color/ql_gray_50"
                                app:cornerRadius="18dp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Cartão do motorista (foto/ilustração do carro, avatar, nota, licença, contacto). -->
                <LinearLayout
                    android:id="@+id/driverCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="86dp"
                            android:layout_weight="1">

                            <ImageView
                                android:id="@+id/vehicleImage"
                                android:layout_width="132dp"
                                android:layout_height="66dp"
                                android:layout_gravity="start|bottom"
                                android:contentDescription="@null"
                                android:scaleType="fitEnd"
                                android:src="@drawable/ic_car"
                                android:tint="@color/ql_gray_400" />

                            <TextView
                                android:id="@+id/avatar"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="start|top"
                                android:background="@drawable/bg_avatar"
                                android:gravity="center"
                                android:textColor="@color/ql_black"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/driverRating"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_marginStart="34dp"
                                android:background="@drawable/bg_map_control"
                                android:drawablePadding="4dp"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:textColor="@color/ql_black"
                                android:textSize="13sp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/vehiclePlate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/ql_black"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/driverDetail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="end"
                                android:maxLines="2"
                                android:textColor="@color/ql_black"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/driverName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ql_black"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/driverLicense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/ql_gray_500"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/messageButton"
                            style="@style/Widget.QolariLite.Button.Light"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="@string/trip_message"
                            android:textSize="16sp"
                            app:icon="@drawable/ic_message"
                            app:iconGravity="textStart"
                            app:iconTint="@color/ql_black" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/callButton"
                            style="@style/Widget.QolariLite.Button.Light"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:layout_marginStart="8dp"
                            app:icon="@drawable/ic_phone"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@color/ql_black" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pinCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_tile"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/trip_pin_label"
                        android:textColor="@color/ql_gray_500"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/pinValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.18"
                        android:textColor="@color/ql_black"
                        android:textSize="42sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/fareCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/trip_fare"
                        android:textColor="@color/ql_gray_500"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/fareValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/ql_black"
                        android:textSize="26sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ratingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/trip_rate_title"
                        android:textColor="@color/ql_black"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/trip_rate_subtitle"
                        android:textColor="@color/ql_gray_500"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/stars"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <ImageButton android:id="@+id/star1" style="@style/StarButton" />
                        <ImageButton android:id="@+id/star2" style="@style/StarButton" />
                        <ImageButton android:id="@+id/star3" style="@style/StarButton" />
                        <ImageButton android:id="@+id/star4" style="@style/StarButton" />
                        <ImageButton android:id="@+id/star5" style="@style/StarButton" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendRating"
                        style="@style/Widget.QolariLite.Button"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/trip_rate_send" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/skipRating"
                        style="@style/Widget.QolariLite.Button.Ghost"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/trip_rate_skip" />
                </LinearLayout>

                <!-- "Cancelar viagem" em texto carmim sobre fundo claro, como no original. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    style="@style/Widget.QolariLite.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/trip_cancel"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/retryButton"
                    style="@style/Widget.QolariLite.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="@string/trip_retry"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/homeButton"
                    style="@style/Widget.QolariLite.Button.Light"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/trip_home"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/ql_red"
                    android:textSize="15sp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="@color/ql_black"
        app:layout_constraintBottom_toBottomOf="@id/map"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/map" />

</androidx.constraintlayout.widget.ConstraintLayout>
