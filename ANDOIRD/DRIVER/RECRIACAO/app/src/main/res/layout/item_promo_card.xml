<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_promo_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="18dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/promoTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/qd_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/promoSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/qd_core_gray600"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Miniatura de mapa (captura 061): pequena, à direita do texto. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="44dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/promoThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/map_thumb" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Barra de progresso vazia no fundo do cartão (captura 061). -->
    <View
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_promo_track" />
</LinearLayout>
