<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="32dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!-- Janela "Erro" (capturas 115b/125b): ícone de aviso, título, mensagem e dois botões. -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_warning"
        app:tint="@color/qd_core_red600" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/error_sheet_title"
        android:textColor="@color/qd_ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal"
        android:text="@string/error_sheet_body"
        android:textColor="@color/qd_ink"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/errorRetry"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:text="@string/error_sheet_retry"
        android:textColor="@color/qd_core_white"
        android:textSize="16sp"
        app:backgroundTint="@color/qd_ink"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/errorCancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/error_sheet_cancel"
        android:textColor="@color/qd_ink"
        android:textSize="16sp"
        app:backgroundTint="@color/qd_tile"
        app:cornerRadius="8dp" />
</LinearLayout>
