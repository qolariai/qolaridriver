<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ql_dark_bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a11y_back"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="@color/ql_dark_text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginStart="@dimen/ql_margin"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="@dimen/ql_margin"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_input"
            android:hint="@string/help_search"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/ql_dark_text"
            android:textColorHint="@color/ql_dark_text_secondary"
            android:textSize="19sp" />

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="58dp"
            android:layout_height="match_parent"
            android:background="@color/ql_dark_text"
            android:contentDescription="@string/a11y_search"
            android:padding="16dp"
            android:src="@drawable/ic_search"
            app:tint="@color/ql_dark_bg" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ql_margin"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="@dimen/ql_margin"
        android:fontFamily="sans-serif-medium"
        android:text="@string/help_topics"
        android:textColor="@color/ql_dark_text"
        android:textSize="32sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/topics"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:indeterminateTint="@color/ql_dark_text"
        android:visibility="gone" />

</LinearLayout>
