<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/ui__corner_radius" android:color="@color/ub__uber_black_60" />
            <corners android:radius="@dimen/ui__corner_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/ui__corner_radius" android:color="@color/ub__uber_black_80" />
            <corners android:radius="@dimen/ui__corner_radius" />
        </shape>
    </item>
</selector>
