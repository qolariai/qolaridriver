{
  "schema": "qolari.ecosystem.endpoints/1",
  "app": "Ecossistema Qolari (Driver + Rider + Fleet + Backoffice)",
  "versao": "1.0",
  "data": "2026-10-25",
  "fonte": "BACKEND/ (handlers implementados) + ANDOIRD/DRIVER/endpoints.json (catalogo extraido) + BACKEND/contracts/ (Rider e Fleet)",
  "nota": "Contrato curado do NOSSO backend (fluxos principais e orquestracao). O catalogo completo esta em catalogo_extraido. Nao e o protocolo da Uber e nao foi copiado dele. As formas marcadas 'served' foram materializadas e validadas pelas apps do laboratorio; 'designed' e contrato novo (Lite/backoffice).",
  "apps": [
    {
      "nome": "Driver",
      "role": "motorista",
      "plataforma": "Android",
      "pacote": "com.qolari.drivereplica",
      "stack": "Kotlin + Views/Compose por evidencia"
    },
    {
      "nome": "Rider",
      "role": "passageiro",
      "plataforma": "Android",
      "pacote": "com.qolari.rider",
      "stack": "Kotlin (laboratorio); referencia Uber Lite e WebView"
    },
    {
      "nome": "Fleet",
      "role": "frota",
      "plataforma": "Android",
      "pacote": "com.qolari.fleet",
      "stack": "Kotlin (laboratorio)"
    },
    {
      "nome": "Backoffice",
      "role": "ops/suporte/financeiro",
      "plataforma": "Web",
      "pacote": "BACKOFFICE/",
      "stack": "React + Vite + TypeScript"
    }
  ],
  "convencoes": {
    "evidence": [
      "live",
      "served",
      "static",
      "unverified",
      "presumed",
      "designed"
    ],
    "integrity": [
      "clean",
      "repack_suspect"
    ],
    "owner": "servico que possui a escrita do recurso (um so)",
    "producer": "app/role que chama",
    "consumers": "apps/roles que reagem ao resultado",
    "emits": "evento publicado quando o estado muda",
    "subscribes": "eventos que o ecra consome",
    "peer_trigger": "estado seguinte depende de outro role"
  },
  "hosts": {
    "driver": "http://192.168.1.204:80 (LAN) / https://driver.qolari.com (servidor)",
    "rider": "http://192.168.1.204:8090",
    "fleet": "http://192.168.1.204:3000",
    "backoffice": "http://127.0.0.1:8300",
    "nota": "No laboratorio a app e escolhida pela porta local; em producao seria pelo host. Nenhum segredo neste ficheiro."
  },
