<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.QolariLite" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ql_black</item>
        <item name="colorOnPrimary">@color/ql_white</item>
        <item name="colorSecondary">@color/ql_blue</item>
        <item name="android:colorBackground">@color/ql_white</item>
        <item name="colorSurface">@color/ql_white</item>
        <item name="colorSurfaceContainer">@color/ql_white</item>
        <item name="colorOnSurface">@color/ql_black</item>
        <item name="colorOnSurfaceVariant">@color/ql_gray_500</item>
        <item name="elevationOverlayEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/ql_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialButtonStyle">@style/Widget.QolariLite.Button</item>
    </style>

    <!-- Escala tipografica medida: o titulo da Home tem 52sp e line-height 62sp. -->
    <style name="TextAppearance.QolariLite.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">52sp</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:lineSpacingMultiplier">1.12</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ql_black</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.QolariLite.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ql_black</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.QolariLite.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ql_black</item>
    </style>

    <style name="TextAppearance.QolariLite.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/ql_black</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TextAppearance.QolariLite.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ql_gray_500</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.QolariLite.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ql_gray_500</item>
    </style>

    <style name="Widget.QolariLite.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/ql_button_height</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">8dp</item>
        <item name="backgroundTint">@color/ql_black_true</item>
        <item name="android:textColor">@color/ql_white</item>
        <item name="iconTint">@color/ql_white</item>
    </style>

    <style name="Widget.QolariLite.Button.Light" parent="Widget.QolariLite.Button">
        <item name="backgroundTint">@color/ql_gray_50</item>
        <item name="android:textColor">@color/ql_black</item>
        <item name="iconTint">@color/ql_black</item>
    </style>

    <style name="Widget.QolariLite.Button.Ghost" parent="Widget.QolariLite.Button">
        <item name="backgroundTint">@color/ql_transparent</item>
        <item name="android:textColor">@color/ql_black</item>
        <item name="iconTint">@color/ql_black</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.QolariLite.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="android:textSize">16sp</item>
        <item name="chipBackgroundColor">@color/ql_gray_50</item>
        <item name="android:textColor">@color/ql_black</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">28dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="chipIconTint">@color/ql_black</item>
    </style>

    <style name="Widget.QolariLite.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="iconTint">@color/ql_black</item>
        <item name="backgroundTint">@color/ql_transparent</item>
        <item name="android:minWidth">@dimen/ql_touch</item>
        <item name="android:minHeight">@dimen/ql_touch</item>
    </style>

    <style name="StarButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">9dp</item>
        <item name="backgroundTint">@color/ql_transparent</item>
        <item name="iconTint">@color/ql_black</item>
        <item name="icon">@drawable/ic_star_outline</item>
        <item name="iconSize">26dp</item>
    </style>

    <style name="AccountRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="AccountIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="AccountText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">18dp</item>
        <item name="android:textColor">@color/ql_black</item>
        <item name="android:textSize">19sp</item>
    </style>


</resources>
