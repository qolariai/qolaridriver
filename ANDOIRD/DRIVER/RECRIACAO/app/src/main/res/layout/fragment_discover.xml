<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qd_background"
    android:orientation="vertical">

    <!-- Descobrir (capturas 010, 061, 081): filtros logo por baixo do título, depois a faixa de dias. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="56dp"
        android:paddingEnd="16dp"
        android:text="@string/tab_discover"
        android:textColor="@color/qd_ink"
        android:textSize="35sp"
        android:letterSpacing="-0.02"
        android:fontFamily="sans-serif" />

    <include
        android:id="@+id/chipsHeader"
        layout="@layout/item_discover_chips" />

    <HorizontalScrollView
        android:id="@+id/dayStripScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/dayStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/qd_line" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/discoverList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="64dp" />
</LinearLayout>
