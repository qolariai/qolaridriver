<?xml version="1.0" encoding="utf-8"?>
<!--
  Cartão inferior do ecrã de recolha (vídeo 2026-10-29, 0:20):
  "5 min  ● 1,7 km" e por baixo "A recolher SHARON", com o ícone de lista à direita.
  É o painel de estado da viagem enquanto o motorista se dirige à recolha.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickupNavBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@color/qd_background"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="18dp"
    android:visibility="gone">

    <!-- Pilula cinzenta de arrasto (video 2026-10-30): a barra pode ser puxada.
         E decorativa: quem trata do toque e o painel de baixo. -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_pill_gray" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

    <!-- Esquerda: filtros (no vídeo da Uber é o ícone de regulações, não a lista) -->
    <ImageView
        android:id="@+id/pickupNavIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_filter"
        app:tint="@color/qd_ink" />

    <!-- O bloco do tempo/distancia e do nome fica CENTRADO no espaco livre entre os dois
         icones (print de 2026-10-30): antes encostava a esquerda e o texto saia do eixo. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pickupNavEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/qd_ink"
                android:textSize="24sp" />

            <!-- Disco verde com a pessoa branca dentro, como no video de 2026-10-30.
                 Antes era a silhueta com tint verde: a pessoa desaparecia no fundo.
                 Sem tint aqui: as cores vivem dentro do drawable. -->
            <ImageView
                android:id="@+id/pickupNavDot"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person_disc" />

            <TextView
                android:id="@+id/pickupNavDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/qd_ink"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pickupNavTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:textColor="@color/qd_ink"
            android:textSize="20sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pickupNavOptions"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_list"
        app:tint="@color/qd_ink" />
    </LinearLayout>
</LinearLayout>
