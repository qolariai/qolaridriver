<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qd_tile">

    
    <com.qolari.drivereplica.ui.home.RealMapView
        android:id="@+id/mapFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/mapHome"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="@string/tab_home"
        android:elevation="3dp"
        android:padding="13dp"
        android:src="@drawable/ic_home_map"
        app:tint="@color/qd_ink" />

    <LinearLayout
        android:id="@+id/mapPro"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pill_pro"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_diamond"
            app:tint="@color/qd_gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/map_pro"
            android:textColor="@color/qd_core_white"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/qd_core_white" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/mapSearch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="@string/map_search"
        android:elevation="3dp"
        android:padding="13dp"
        android:src="@drawable/ic_search"
        app:tint="@color/qd_ink" />

    
    <LinearLayout
        android:id="@+id/mapShortcuts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="132dp"
        android:orientation="vertical">

        <!-- O raio (⚡) saiu: no original só aparece em banners de Boost e não temos
             ecrã de zonas. Ficava um ícone a prometer o que não existe (decisão de 2026-10-31). -->

        <ImageButton
            android:id="@+id/mapReportShortcut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/map_report"
            android:elevation="3dp"
            android:padding="13dp"
            android:src="@drawable/ic_pin_plus"
            app:tint="@color/qd_core_orange500" />

        <ImageButton
            android:id="@+id/mapTrendsShortcut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/map_trends"
            android:elevation="3dp"
            android:padding="13dp"
            android:src="@drawable/ic_chart"
            app:tint="@color/qd_ink" />

        <ImageButton
            android:id="@+id/mapLocateShortcut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/map_locate"
            android:elevation="3dp"
            android:padding="13dp"
            android:src="@drawable/ic_locate"
            app:tint="@color/qd_ink" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/mapShield"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="132dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="@string/menu_safety"
        android:elevation="3dp"
        android:padding="13dp"
        android:src="@drawable/ic_shield"
        app:tint="@color/qd_core_blue600" />

    
    <TextView
        android:id="@+id/mapStart"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="124dp"
        android:background="@drawable/bg_start_button"
        android:elevation="4dp"
        android:gravity="center"
        android:text="@string/map_start"
        android:textColor="@color/qd_core_white"
        android:textSize="14sp"
        android:textStyle="bold" />

    
    <LinearLayout
        android:id="@+id/radarPill"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:background="@drawable/bg_pill_radar"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drive_radar"
            android:textColor="@color/qd_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/radarCount"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle_badge"
            android:gravity="center"
            android:textColor="@color/qd_core_white"
            android:textSize="13sp" />
    </LinearLayout>

    <include
        android:id="@+id/offerCard"
        layout="@layout/view_offer_card" />

    <!-- Flash do pedido (Definições > Acessibilidade > Iluminação do ecrã para pedidos). -->
    <View
        android:id="@+id/offerFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/qd_core_white"
        android:clickable="false"
        android:focusable="false" />

    <include
        android:id="@+id/tripCard"
        layout="@layout/view_trip_card" />

    <!-- Ecrã de recolha (vídeo 2026-10-29): painel de manobras em cima e barra de estado em baixo. -->
    <include
        android:id="@+id/maneuverPanel"
        layout="@layout/view_maneuver_panel" />

    <include
        android:id="@+id/pickupNavBar"
        layout="@layout/view_pickup_nav_bar" />

    <!-- Espera na recolha (vídeo 2026-10-30): contador + contacto + "Começar <produto>". -->
    <include
        android:id="@+id/waitCard"
        layout="@layout/view_wait_card" />

    <!-- Botão "Navegar" (vídeo 2026-10-29): só no ecrã de recolha, por cima da barra inferior. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/navButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="112dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="@string/nav_navigate"
        android:textColor="@color/qd_core_white"
        android:textSize="16sp"
        android:visibility="gone"
        app:backgroundTint="@color/qd_maneuver_bg"
        app:cornerRadius="22dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_navigate_ne"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="18dp"
        app:iconTint="@color/qd_core_white" />

    <!-- Botões da navegação (vídeo 2026-10-30): à direita o A+ (relatar obstáculo) e o
         atalho do percurso; à esquerda o escudo de segurança e os filtros de serviços. -->
    <LinearLayout
        android:id="@+id/navActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="112dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/navReport"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_map_round_button"
            android:contentDescription="@string/report_title"
            android:elevation="3dp"
            android:padding="13dp"
            android:src="@drawable/ic_auto_accept" />

        <ImageButton
            android:id="@+id/navRoute"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_map_round_button"
            android:contentDescription="@string/map_route"
            android:elevation="3dp"
            android:padding="13dp"
            android:src="@drawable/ic_route"
            app:tint="@color/qd_ink" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/navShield"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="112dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="@string/safety_toolkit_title"
        android:elevation="3dp"
        android:padding="13dp"
        android:src="@drawable/ic_shield"
        android:tint="@color/qd_core_blue600"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/navFilters"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="172dp"
        android:background="@drawable/bg_circle_white"
        android:contentDescription="@string/home_preferences"
        android:elevation="3dp"
        android:padding="13dp"
        android:src="@drawable/ic_filter"
        android:tint="@color/qd_ink"
        android:visibility="gone" />

    <!-- Aviso de gravacao de audio (video 2026-10-30, 0:00-0:07).
         Fica DEPOIS da barra para ser desenhado por cima dela, mas sobe o suficiente para nao
         tapar os controlos: o deslocamento e aplicado em MapFragment.updateAudioNotice(). -->
    <include
        android:id="@+id/audioNotice"
        layout="@layout/view_audio_notice" />

    <!-- Selo de limite de velocidade, encostado ao canto inferior esquerdo. -->
    <LinearLayout
        android:id="@+id/speedBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="112dp"
        android:background="@drawable/bg_speed_badge"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/speedLimit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/qd_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_limit"
            android:textColor="@color/qd_ink"
            android:textSize="12sp" />
    </LinearLayout>

    
    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_panel_map"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_gray" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/mapPrefs"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home_preferences"
                android:padding="12dp"
                android:src="@drawable/ic_filter"
                app:tint="@color/qd_ink" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mapStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/qd_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mapStatusHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/qd_core_red600"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/mapList"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_content"
                android:padding="12dp"
                android:src="@drawable/ic_list"
                app:tint="@color/qd_ink" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>

