# Copiar para /etc/qolari/qolari.env (chmod 600). NÃO versionar com valores reais.
ENVIRONMENT=production
BIND_HOST=127.0.0.1
EXTRA_APP_PORTS=
PUBLIC_HOST=driver.qolari.com

DB_URL=postgresql+psycopg://qolari:TROCAR@127.0.0.1:5432/qolari
SECRET=TROCAR-POR-32-BYTES-ALEATORIOS
ADMIN_EMAIL=admin@qolari.com
ADMIN_PASSWORD=TROCAR
STRICT_AUTH=1
RATE_LIMIT=1

# OTP real ainda não implementado; ver DEPLOY.md §2.
OTP_CODE=TROCAR

# Backend de geocoding/rotas (a chave das apps está em local.properties).
GOOGLE_MAPS_KEY=TROCAR
FCM_PROJECT_ID=qolari-driver-prod
FCM_SERVICE_ACCOUNT=/opt/qolari/BACKEND/data/firebase-service-account.json
ROUTING_URL=https://router.project-osrm.org
ROUTE_CACHE_TTL_S=600

# Portas locais (nginx faz o TLS à frente).
DRIVER_PORT=8091
RIDER_PORT=8090
FLEET_PORT=3000
CONSOLE_PORT=8300
DRIVER_GRPC_PORT=8092
