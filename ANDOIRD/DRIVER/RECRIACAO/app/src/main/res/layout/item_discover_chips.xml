<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/chipReminders"
            style="@style/Widget.QolariDriver.Chip"
            android:drawableStart="@drawable/ic_bookmark"
            android:text="@string/discover_reminders" />

        <TextView
            android:id="@+id/chipPromos"
            style="@style/Widget.QolariDriver.Chip"
            android:drawableStart="@drawable/ic_burst"
            android:text="@string/discover_promos" />

        <TextView
            android:id="@+id/chipAirports"
            style="@style/Widget.QolariDriver.Chip"
            android:drawableStart="@drawable/ic_plane"
            android:text="@string/discover_airports" />
    </LinearLayout>
</HorizontalScrollView>
