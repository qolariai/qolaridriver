<?xml version="1.0" encoding="utf-8"?>
<!--
  Botão A+ do mapa durante a recolha/viagem (print 2026-10-30, 02:16).
  Abre os relatórios de mapa para avisar os próximos condutores de um obstáculo.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#F2F2F2" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/qd_core_white" />
        </shape>
    </item>
</selector>
