<?xml version="1.0" encoding="utf-8"?>
<!--
  Cartão inferior do ecrã de recolha (vídeo 2026-10-29, 0:20):
  "5 min  ● 1,7 km" e por baixo "A recolher SHARON", com o ícone de lista à direita.
  É o painel de estado da viagem enquanto o motorista se dirige à recolha.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pickupNavBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@color/qd_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp"
    android:visibility="gone">

    <!-- Esquerda: filtros (no vídeo da Uber é o ícone de regulações, não a lista) -->
    <ImageView
        android:id="@+id/pickupNavIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_filter"
        app:tint="@color/qd_ink" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pickupNavEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/qd_ink"
                android:textSize="24sp" />

            <ImageView
                android:id="@+id/pickupNavDot"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person_filled"
                app:tint="@color/qd_core_green600" />

            <TextView
                android:id="@+id/pickupNavDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/qd_ink"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pickupNavTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/qd_ink"
            android:textSize="20sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pickupNavOptions"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_list"
        app:tint="@color/qd_ink" />
</LinearLayout>
