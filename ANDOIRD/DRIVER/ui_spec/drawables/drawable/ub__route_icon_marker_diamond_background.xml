        <rotate android:fromDegrees="45.0">
            <shape>
                <corners android:radius="@dimen/ub__route_icon_marker_corner_radius" />
                <size android:height="@dimen/ub__route_icon_marker_large_height" android:width="@dimen/ub__route_icon_marker_large_width" />
                <solid android:color="?iconColor" />
                <stroke android:width="@dimen/ub__route_icon_border_width" android:color="?iconColor" />
            </shape>
        </rotate>
    </item>
</layer-list>
