        "backoffice"
      ],
      "screens": [
        "Login por telefone (Driver/Rider/Fleet)"
      ],
      "request": {
        "grant_type": "password|refresh_token",
        "username": "telefone",
        "password": "codigo do laboratorio",
        "refresh_token": "opcional"
      },
      "response": {
        "accessToken": "string",
        "refreshToken": "string",
        "tokenType": "Bearer",
        "expiresIn": "int"
