<?xml version="1.0" encoding="utf-8"?>
<!-- Uma linha da folha de itinerário: rótulo à esquerda, valor à direita (print 02:06). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <TextView
        android:id="@+id/itineraryRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="38"
        android:textColor="@color/qd_core_gray700"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/itineraryRowValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="62"
        android:textColor="@color/qd_ink"
        android:textSize="15sp" />
</LinearLayout>
