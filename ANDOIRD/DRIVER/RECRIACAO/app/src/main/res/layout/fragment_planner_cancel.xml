<?xml version="1.0" encoding="utf-8"?>
<!--
  Cancelamento a partir do planeador (print 2026-10-30, 01:59).
  Cabeçalho com o passageiro e a morada, e a lista de motivos para desistir da viagem que
  já foi aceite (engano, rota, não compensa, não é segura...).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qd_background"
    android:orientation="vertical">

    <ImageButton
        android:id="@+id/plannerCancelBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back"
        app:tint="@color/qd_ink" />

    <!-- Cabeçalho do passageiro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/plannerCancelName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/qd_ink"
                android:textSize="30sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/plannerCancelChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_white"
                android:contentDescription="@string/contact_chat"
                android:elevation="1dp"
                android:padding="10dp"
                android:src="@drawable/ic_chat_bubble"
                app:tint="@color/qd_ink" />
        </LinearLayout>

        <TextView
            android:id="@+id/plannerCancelMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/qd_ink"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="2dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pin"
                app:tint="@color/qd_ink" />

            <TextView
                android:id="@+id/plannerCancelAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/qd_ink"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/qd_line" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp"
        android:text="@string/cancel_prompt"
        android:textColor="@color/qd_core_gray600"
        android:textSize="17sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/plannerCancelRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/plannerCancelConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/cancel_confirm"
        android:textColor="@color/qd_core_white"
        android:textSize="17sp"
        android:visibility="gone"
        app:backgroundTint="@color/qd_ink"
        app:cornerRadius="8dp" />
</LinearLayout>
