<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/eventTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/qd_core_gray600"
            android:textSize="14sp" />

        <!-- A original tem a seta de abertura no canto superior direito do evento (captura 061). -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron"
            app:tint="@color/qd_ink" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/qd_ink"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/eventPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/qd_core_gray600"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/eventTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill_gray_soft"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textColor="@color/qd_ink"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginStart="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/eventThumbCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/eventThumb"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/map_thumb" />
            </com.google.android.material.card.MaterialCardView>

            <ImageView
                android:id="@+id/eventPlane"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:rotation="35"
                android:src="@drawable/ic_plane_filled"
                android:visibility="gone"
                app:tint="@color/qd_core_blue600" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/eventSave"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill_gray_soft"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:textColor="@color/qd_ink"
        android:textSize="14sp"
        app:drawableStartCompat="@drawable/ic_bookmark"
        app:drawableTint="@color/qd_ink" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/qd_line" />
</LinearLayout>
