<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de um serviço nas Preferências (print 2026-10-30, 02:10). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="118dp"
    android:layout_margin="5dp"
    android:background="@drawable/bg_prefs_tile"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/prefsTileCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_check_box" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/prefsTileIcon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:importantForAccessibility="no"
        app:tint="@color/qd_ink" />

    <TextView
        android:id="@+id/prefsTileLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/qd_ink"
        android:textSize="17sp" />
</LinearLayout>
