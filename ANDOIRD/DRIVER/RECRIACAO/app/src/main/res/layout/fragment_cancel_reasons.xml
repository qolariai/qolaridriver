<?xml version="1.0" encoding="utf-8"?>
<!--
  Motivos de cancelamento (print do vídeo 2026-10-30 17:30).
  Abre ao tocar no ícone de pessoa do ecrã de espera.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qd_background"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp">

    <ImageButton
        android:id="@+id/cancelBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="-12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:padding="12dp"
        android:src="@drawable/ic_back"
        app:tint="@color/qd_ink" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/cancel_prompt"
        android:textColor="@color/qd_ink"
        android:textSize="19sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/cancelReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelConfirm"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/cancel_confirm"
        android:textColor="@color/qd_core_white"
        android:textSize="17sp"
        android:visibility="gone"
        app:backgroundTint="@color/qd_ink"
        app:cornerRadius="8dp" />

    <!-- "Cancelar" volta atrás sem cancelar a viagem (pedido de 2026-10-30). -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelBack2"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/cancel_abort"
        android:textColor="@color/qd_ink"
        android:textSize="17sp"
        app:cornerRadius="8dp"
        app:strokeColor="@color/qd_line" />
</LinearLayout>
