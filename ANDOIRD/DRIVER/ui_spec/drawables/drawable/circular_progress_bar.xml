<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="ring" android:useLevel="false" android:innerRadius="@dimen/carbon_ui__basic_info_circle_radius" android:thickness="@dimen/ub__progress_fab_stroke_width">
            <solid android:color="?brandBlack" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <rotate android:fromDegrees="270.0" android:toDegrees="270.0" android:pivotX="50.0%" android:pivotY="50.0%">
            <shape android:shape="ring" android:innerRadius="@dimen/carbon_ui__basic_info_circle_radius" android:thickness="@dimen/ub__progress_fab_stroke_width">
                <solid android:color="?brandWhite" />
            </shape>
        </rotate>
    </item>
</layer-list>
