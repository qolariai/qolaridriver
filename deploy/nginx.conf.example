    listen 443 ssl http2;
    server_name fleet.qolari.com;

    ssl_certificate     /etc/letsencrypt/live/fleet.qolari.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fleet.qolari.com/privkey.pem;
