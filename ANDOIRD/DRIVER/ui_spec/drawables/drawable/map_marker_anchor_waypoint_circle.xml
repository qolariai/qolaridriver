            <stroke android:height="@dimen/ui__spacing_unit_1x" android:width="@dimen/ui__spacing_unit_1x" android:color="?transparent" />
            <size android:height="@dimen/ui__spacing_unit_1x" android:width="@dimen/ui__spacing_unit_1x" />
        </shape>
    </item>
</layer-list>
