<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_margin="12dp"
    android:background="@drawable/bg_card_drive"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/tripTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/qd_ink"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tripRider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/qd_core_gray600"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pin_plus"
            app:tint="@color/qd_ink" />

        <TextView
            android:id="@+id/tripAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/qd_ink"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tripWait"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/qd_core_gray600"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tripFare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/qd_core_gray600"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tripPinButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:text="@string/drive_enter_pin"
        android:textColor="@color/qd_core_white"
        android:textSize="16sp"
        android:visibility="gone"
        app:backgroundTint="@color/qd_ink"
        app:cornerRadius="8dp" />

    <com.qolari.drivereplica.drive.SlideToConfirmView
        android:id="@+id/tripSlide"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="14dp" />
</LinearLayout>
