        <shape android:shape="oval">
            <size android:height="@dimen/map_marker_anchor_height" android:width="@dimen/map_marker_anchor_width" />
        </shape>
    </item>
    <item android:id="@id/map_marker_anchor_waypoint_circle_fill">
