<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qd_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Código (passo seguinte ao 033): título, campo, erro e a dupla seta/"Seguinte" no fundo como na captura 033. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_code_title"
        android:textColor="@color/qd_ink"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/codeSentTo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/qd_core_gray600"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/codeInput"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:importantForAutofill="no"
        android:background="@drawable/bg_input"
        android:gravity="center_vertical"
        android:imeOptions="actionDone"
        android:inputType="number"
        android:maxLength="4"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/qd_ink"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/codeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/qd_core_red600"
        android:textSize="14sp"
        android:visibility="gone" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/codeBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_circle_light"
            android:contentDescription="@string/back"
            android:padding="16dp"
            android:src="@drawable/ic_back"
            app:tint="@color/qd_ink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/codeNext"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="end"
            android:enabled="false"
            android:text="@string/login_next"
            android:textColor="@color/btn_black_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_black_bg"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="end" />
    </FrameLayout>
</LinearLayout>
