<?xml version="1.0" encoding="utf-8"?>
<!--
  "Planeador de viagem" (print 2026-10-30, 01:57): ecrã inteiro aberto pelo botão de lista
  do canto inferior direito, com a recolha e a entrega e o botão "Parar novos pedidos".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qd_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/planner_title"
            android:textColor="@color/qd_ink"
            android:textSize="24sp" />

        <ImageButton
            android:id="@+id/plannerClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_list"
            app:tint="@color/qd_ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/qd_line" />

    <!-- Recolha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/plannerPickupDot"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_planner_green"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_person_filled"
            app:tint="@color/qd_core_white" />

        <TextView
            android:id="@+id/plannerPickupText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textColor="@color/qd_ink"
            android:textSize="19sp" />

        <ImageButton
            android:id="@+id/plannerPickupMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/planner_pickup"
            android:src="@drawable/ic_overflow"
            app:tint="@color/qd_ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="64dp"
        android:background="@color/qd_line" />

    <!-- Entrega -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="8dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/plannerDropoffDot"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_planner_gray"
            android:importantForAccessibility="no"
            android:padding="7dp"
            android:src="@drawable/ic_person_filled"
            app:tint="@color/qd_core_white" />

        <TextView
            android:id="@+id/plannerDropoffText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textColor="@color/qd_ink"
            android:textSize="19sp" />

        <ImageButton
            android:id="@+id/plannerDropoffMenu"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/planner_dropoff"
            android:src="@drawable/ic_overflow"
            app:tint="@color/qd_ink" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/qd_line" />

    <TextView
        android:id="@+id/plannerSheetLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="@string/planner_sheet"
        android:textColor="@color/qd_core_blue600"
        android:textSize="17sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/qd_line" />

    <!-- Barra inferior: filtros, "Parar novos pedidos", procura -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/plannerFilters"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/home_preferences"
            android:src="@drawable/ic_filter"
            app:tint="@color/qd_ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/plannerStopIcon"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:background="@drawable/bg_circle_stop_red"
                android:importantForAccessibility="no"
                android:padding="13dp"
                android:src="@drawable/ic_stop_requests" />

            <TextView
                android:id="@+id/plannerStopLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/planner_stop_requests"
                android:textColor="@color/qd_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/plannerSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/map_search"
            android:src="@drawable/ic_search"
            app:tint="@color/qd_ink" />
    </LinearLayout>
</LinearLayout>
