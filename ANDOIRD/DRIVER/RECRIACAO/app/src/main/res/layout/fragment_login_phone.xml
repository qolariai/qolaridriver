<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qd_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="24dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- Telefone (captura 032): título, prefixo do país, número e "Continuar". Sem Google nem e-mail: o backend só tem telefone. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_phone_title"
        android:textColor="@color/qd_ink"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_chip_country"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/login_country_pt"
            android:textColor="@color/qd_ink"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/phoneInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:autofillHints="phoneNational"
            android:background="@drawable/bg_input"
            android:hint="@string/login_phone_hint"
            android:imeOptions="actionDone"
            android:inputType="phone"
            android:maxLength="11"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/qd_ink"
            android:textColorHint="@color/qd_core_gray600"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/phoneError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/qd_core_red600"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/phoneContinue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:enabled="false"
        android:text="@string/welcome_continue"
        android:textColor="@color/btn_black_text"
        android:textSize="16sp"
        app:backgroundTint="@color/btn_black_bg"
        app:cornerRadius="8dp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_sms_notice"
        android:textColor="@color/qd_core_gray600"
        android:textSize="12sp" />
</LinearLayout>
