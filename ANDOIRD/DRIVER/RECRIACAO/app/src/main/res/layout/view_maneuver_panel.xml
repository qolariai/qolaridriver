<?xml version="1.0" encoding="utf-8"?>
<!--
  Painel de navegação (vídeo 2026-10-30, 0:04). Bloco preto com duas secções separadas por um risco:

    Secção 1 (manobra): seta grande + distância ("140" grande, "m" pequeno) + texto rico:
                        "Avenida Duque de Loulé em direção a Praça do Marquês de Pombal"
                        (via a branco, "em direção a" em cinza e mais pequeno)
    Secção 2 (alterna):
                        - enquanto há outra manobra à frente -> seta pequena + rua (1 linha)
                        - quando já é a última                       -> quadrado verde (recolha) ou
                          vermelho (entrega) + morada + cidade, centrado

  No destino final a secção 1 passa a uma bandeira com a morada de entrega.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/maneuverPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_maneuver_panel"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Secção 1: a manobra -->
    <LinearLayout
        android:id="@+id/maneuverSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/maneuverIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_maneuver_left"
                app:tint="@color/qd_core_white" />

            <!-- Distância: número grande + unidade pequena, como no painel do vídeo. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/maneuverDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/qd_core_white"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/maneuverDistanceUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/qd_core_white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Texto rico: via a branco + "em direção a" cinza + destino a branco. -->
        <TextView
            android:id="@+id/maneuverRoad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:textColor="@color/qd_core_white"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Divisor entre as duas secções -->
    <View
        android:id="@+id/maneuverDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#606060" />

    <!-- Secção 2a: a próxima manobra (enquanto houver outra à frente) -->
    <LinearLayout
        android:id="@+id/nextSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="11dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <ImageView
            android:id="@+id/nextIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_maneuver_right"
            app:tint="@color/qd_core_white" />

        <TextView
            android:id="@+id/nextRoad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/qd_core_white"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Secção 2b: a paragem (recolha na ida, entrega na viagem), com o texto centrado. -->
    <LinearLayout
        android:id="@+id/stopSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="11dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <View
            android:id="@+id/stopDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_stop_dot_pickup" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/stopAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/qd_core_white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/stopCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/qd_core_white"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
