<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ql_white">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ql_margin"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/home_brand"
                        android:textColor="@color/ql_black"
                        android:textSize="34sp"
                        android:letterSpacing="-0.02" />

                    <ImageButton
                        android:id="@+id/menuButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/a11y_menu"
                        android:padding="12dp"
                        android:src="@drawable/ic_menu"
                        app:tint="@color/ql_black" />
                </LinearLayout>

                <TextView
                    android:id="@+id/savedPlace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ql_margin"
                    android:paddingEnd="@dimen/ql_margin"
                    android:textColor="@color/ql_gray_500"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.12"
                    android:paddingStart="@dimen/ql_margin"
                    android:paddingEnd="@dimen/ql_margin"
                    android:text="@string/home_loading"
                    android:textColor="@color/ql_black"
                    android:textSize="52sp" />

                <LinearLayout
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ql_search_height"
                    android:layout_marginStart="@dimen/ql_margin"
                    android:layout_marginTop="22dp"
                    android:layout_marginEnd="@dimen/ql_margin"
                    android:background="@drawable/bg_search"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/ql_gray_500" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:text="@string/home_search"
                        android:textColor="@color/ql_gray_500"
                        android:textSize="24sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ql_map_height"
                    android:layout_marginTop="18dp">

                    <com.qolari.shared.map.GoogleMapView
                        android:id="@+id/map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:id="@+id/mapSavedPlace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="18dp"
                        android:background="@drawable/bg_map_control"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp"
                        android:textColor="@color/ql_black"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="18dp"
                        android:layout_marginBottom="96dp"
                        android:orientation="vertical">

                        <ImageButton
                            android:id="@+id/locateButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_map_control"
                            android:contentDescription="@string/home_locate"
                            android:padding="12dp"
                            android:src="@drawable/ic_crosshair"
                            app:tint="@color/ql_black" />

                        <ImageButton
                            android:id="@+id/zoomInButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_map_control"
                            android:contentDescription="@string/home_zoom_in"
                            android:padding="13dp"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/ql_black" />

                        <ImageButton
                            android:id="@+id/zoomOutButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_map_control"
                            android:contentDescription="@string/home_zoom_out"
                            android:padding="13dp"
                            android:src="@drawable/ic_minus"
                            app:tint="@color/ql_black" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/ql_margin"
                    android:paddingEnd="@dimen/ql_margin"
                    android:text="@string/home_suggestions"
                    android:textColor="@color/ql_black"
                    android:textSize="32sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ql_margin"
                    android:paddingEnd="@dimen/ql_margin" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/promos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ql_margin"
                    android:paddingEnd="@dimen/ql_margin" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/ql_black"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/errorCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_wifi_off"
                app:tint="@color/ql_gray_500" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/home_error"
                android:textColor="@color/ql_black"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retryButton"
                style="@style/Widget.QolariLite.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/home_retry" />
        </LinearLayout>
    </FrameLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
